---
import "../styles/globals.css";
import {
  getKpiMetrics,
  getTimeSeries,
  getActiveLearners,
  getAppBreakdowns,
} from "../lib/db/dashboard-queries";
import DashboardShell from "../components/dashboard/DashboardShell";

const [kpiMetrics, timeSeries, activeLearners, appBreakdowns] =
  await Promise.all([
    getKpiMetrics(),
    getTimeSeries(30),
    getActiveLearners(),
    getAppBreakdowns(),
  ]);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - LIL</title>
  </head>
  <body class="min-h-screen bg-background font-sans antialiased">
    <DashboardShell
      client:load
      kpiMetrics={kpiMetrics}
      timeSeries={timeSeries}
      activeLearners={activeLearners}
      appBreakdowns={appBreakdowns}
    />
  </body>
</html>
